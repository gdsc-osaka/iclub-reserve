/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",

  /**
   * 環境（env）の構成
   *
   * デプロイ先は `--env` で必ず明示すること。
   *
   * | 環境          | Worker 名                | D1                         |
   * | ------------- | ------------------------ | -------------------------- |
   * | `production`  | `iclub-reserve`          | `iclub-reserve-db`         |
   * | `preview`     | `iclub-reserve-preview`  | `iclub-reserve-preview-db` |
   * | トップレベル  | ローカル開発専用         | `iclub-reserve-preview-db` |
   *
   * `preview` の派生ブランチは、`iclub-reserve-preview` の下の Worker Previews として
   * デプロイする（`env.preview.previews`、ADR-006）。
   *
   * トップレベルの `name` をあえて本番と別名にしてあるのは、`--env` を付け忘れた
   * `wrangler deploy` が本番を上書きするのを防ぐため。付け忘れても、無害な Worker が
   * 1 つ増えるだけで済む。同じ理由で、トップレベルの D1 もプレビュー側を指している。
   *
   * `vars` と `d1_databases`（バインディング全般）は env にも Previews にも**継承されない**ため、
   * 4 か所（トップレベル・`env.production`・`env.preview`・`env.preview.previews`）すべてに
   * 同じ内容を書く必要がある。とくに `vars` のキー集合は 4 つとも揃えること。
   * `wrangler types` は `--env` なし（＝トップレベル）で走るので、
   * トップレベルにないキーは `Env` の型に現れない。
   *
   * 一方 `main` `compatibility_date` `compatibility_flags` `observability`
   * `upload_source_maps` `account_id` は継承されるので、ここに 1 度書けばよい。
   */
  "name": "iclub-reserve-local",
  "account_id": "09381b15a7d3beb91294a7ce295420a4",
  "compatibility_date": "2026-06-20",
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "upload_source_maps": true,

  /**
   * Cron Triggers の設定。
   * triggers は各環境に継承されるため、トップレベルに 1 度だけ定義する（ADR-002 決定 9）。
   */
  "triggers": {
    "crons": ["* * * * *"],
  },

  "vars": {
    /**
     * 実行環境の名前。認証コード（OTP）の届け先の切り替えに使う。
     * 対応は app/infra/mail/mail-sender-factory.server.ts を参照。
     *
     * デプロイ先とこの値が食い違うと、プレビューの認証コードが実メールで飛んだり、
     * 逆に本番の認証コードが Discord に流れたりする。環境を増やすときは必ず見直すこと。
     */
    "APP_ENV": "local",
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
    /**
     * Oracle Email Delivery（SMTP 送信）の設定。
     * 機密でない値のみここに置き、認証情報は .dev.vars / `wrangler secret put` で渡す。
     * ホスト名とポートは OCI コンソールの「SMTP 送信情報」から転記すること。
     *
     * ポートは 465（暗黙 TLS）固定。587 は STARTTLS が必要だが
     * workerd 側が未対応のため使えない (https://github.com/cloudflare/workerd/issues/2712)。
     * ポート 25 は Cloudflare Workers からブロックされている。
     */
    "SMTP_HOST": "smtp.email.ap-osaka-1.oci.oraclecloud.com",
    "SMTP_PORT": "465",
    "MAIL_FROM_ADDRESS": "noreply@gdgoc-osaka.jp",
    "MAIL_FROM_NAME": "i-Club 予約システム",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iclub-reserve-preview-db",
      "database_id": "0de33eb1-9e5c-4721-bda8-7dc7c201157a",
      "migrations_dir": "drizzle/migrations",
    },
  ],

  /**
   * Cloudflare R2 の設定（ADR-005 決定 1）。
   *
   * バインディングは vars や queues と同様に環境に継承されないため、
   * トップレベル、env.production、env.preview、env.preview.previews の 4 か所すべてに記述する必要がある。
   * また、wrangler types はトップレベルを基準に走るため、トップレベルに書かないと
   * Env に MEDIA の型が現れない。
   *
   * バケットは施設写真専用ではなくアプリの画像全般（今後追加される団体のロゴ等）を
   * 集約して保存する。種類はキーの接頭辞で分けており、一覧は app/infra/media/media-bucket.ts に定義する。
   */
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "iclub-reserve-media-preview",
    },
  ],

  /**
   * Cloudflare Queues の設定（ADR-002 決定 1 / 決定 4 / 第 4 節）。
   *
   * queues は vars や d1_databases と同様に環境に継承されないため、
   * トップレベル、env.production、env.preview の 3 か所すべてに記述する必要がある。
   * env.preview.previews には producers だけを書く（consumer は Preview では動かないため。ADR-006）。
   * また、wrangler types はトップレベルを基準に走るため、トップレベルに書かないと
   * Env に MAIL_QUEUE の型が現れない。
   */
  "queues": {
    "producers": [{ "queue": "iclub-reserve-mail-preview", "binding": "MAIL_QUEUE" }],
    "consumers": [
      {
        "queue": "iclub-reserve-mail-preview",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // SMTP の失敗はここでは再試行しない (ADR 決定 4)。consumer が落ちた場合の保険
        "max_retries": 3,
        // OCI の 421 Too many connections を避けるため、同時に開く接続を絞る
        "max_concurrency": 2,
      },
    ],
  },

  "env": {
    /** 本番環境。`main` ブランチから Workers Builds でデプロイされる。 */
    "production": {
      "name": "iclub-reserve",
      /**
       * バージョンごとのプレビュー URL を本番 Worker では発行しない。
       * 本番の Worker 名でレビュー前のコードが公開される事故を防ぐため。
       */
      "preview_urls": false,
      "vars": {
        // 実行環境の名前。詳細はトップレベルの `vars` のコメントを参照。
        "APP_ENV": "production",
        "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
        // SMTP の設定についてはトップレベルの `vars` のコメントを参照。
        "SMTP_HOST": "smtp.email.ap-osaka-1.oci.oraclecloud.com",
        "SMTP_PORT": "465",
        "MAIL_FROM_ADDRESS": "noreply@gdgoc-osaka.jp",
        "MAIL_FROM_NAME": "i-Club 予約システム",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "iclub-reserve-db",
          "database_id": "6ae196e1-208f-4182-b421-e8f8e25fe755",
          "migrations_dir": "drizzle/migrations",
        },
      ],
      // r2_buckets は継承されないため環境ごとに記述。詳細はトップレベルのコメントを参照
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "iclub-reserve-media",
        },
      ],
      // queues は継承されないため環境ごとに記述。詳細はトップレベルのコメントを参照
      "queues": {
        "producers": [{ "queue": "iclub-reserve-mail", "binding": "MAIL_QUEUE" }],
        "consumers": [
          {
            "queue": "iclub-reserve-mail",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            // SMTP の失敗はここでは再試行しない (ADR 決定 4)。consumer が落ちた場合の保険
            "max_retries": 3,
            // OCI の 421 Too many connections を避けるため、同時に開く接続を絞る
            "max_concurrency": 2,
          },
        ],
      },
    },

    /**
     * プレビュー環境。`develop` とその派生ブランチから Workers Builds でデプロイされる。
     *
     * 本番とは Worker も D1 も別物なので、DB を壊しても本番には影響しない。
     * `BETTER_AUTH_SECRET` も本番とは別の値を入れること
     * （同じ値だと本番のセッション Cookie がプレビューでも通ってしまう）。
     *
     * `develop` は Worker 本体として `wrangler deploy --env preview` で、
     * 派生ブランチは Worker Previews として `wrangler preview --env preview` でデプロイする
     * （ADR-006）。どちらも下の `routes` のカスタムドメインで公開する。
     */
    "preview": {
      "name": "iclub-reserve-preview",
      /**
       * workers.dev では公開しない（ADR-006）。
       *
       * パスキーの rpID は BETTER_AUTH_URL のホスト名（iclub-preview.gdgoc-osaka.jp）になるため、
       * workers.dev の URL ではパスキーが使えず、ログインも INVALID_ORIGIN で弾かれる。
       * 使えない URL に人が迷い込まないよう、本体（workers_dev）と
       * ブランチごとの Preview（preview_urls）の両方を止めておく。
       */
      "workers_dev": false,
      "preview_urls": false,
      /**
       * `develop` を `iclub-preview.gdgoc-osaka.jp` で、
       * 派生ブランチの Preview を `<ブランチ名>.iclub-preview.gdgoc-osaka.jp` で公開する。
       *
       * 両方が同じ親ドメインの下にあるので、パスキーの rpID（iclub-preview.gdgoc-osaka.jp）を
       * すべてのプレビューで共有できる。develop で登録したパスキーがどのブランチでも使える。
       * ワイルドカードの DNS レコードと証明書は Cloudflare が自動で作る。
       */
      "routes": [
        {
          "pattern": "iclub-preview.gdgoc-osaka.jp",
          "custom_domain": true,
          "previews_enabled": true,
        },
      ],
      "vars": {
        // 実行環境の名前。詳細はトップレベルの `vars` のコメントを参照。
        // これが "preview" のときだけ、認証コードはメールではなく Discord のスレッドへ届く。
        "APP_ENV": "preview",
        "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
        // SMTP の設定についてはトップレベルの `vars` のコメントを参照。
        "SMTP_HOST": "smtp.email.ap-osaka-1.oci.oraclecloud.com",
        "SMTP_PORT": "465",
        "MAIL_FROM_ADDRESS": "noreply@gdgoc-osaka.jp",
        "MAIL_FROM_NAME": "i-Club 予約システム",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "iclub-reserve-preview-db",
          "database_id": "0de33eb1-9e5c-4721-bda8-7dc7c201157a",
          "migrations_dir": "drizzle/migrations",
        },
      ],
      // r2_buckets は継承されないため環境ごとに記述。詳細はトップレベルのコメントを参照
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "iclub-reserve-media-preview",
        },
      ],
      // queues は継承されないため環境ごとに記述。詳細はトップレベルのコメントを参照
      "queues": {
        "producers": [{ "queue": "iclub-reserve-mail-preview", "binding": "MAIL_QUEUE" }],
        "consumers": [
          {
            "queue": "iclub-reserve-mail-preview",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            // SMTP の失敗はここでは再試行しない (ADR 決定 4)。consumer が落ちた場合の保険
            "max_retries": 3,
            // OCI の 421 Too many connections を避けるため、同時に開く接続を絞る
            "max_concurrency": 2,
          },
        ],
      },

      /**
       * 派生ブランチの Preview（`wrangler preview --env preview`）の設定（ADR-006）。
       *
       * Preview は上の `env.preview` の設定を**継承しない**ため、vars とバインディングを
       * もう一度書く。`vars` のキー集合は、他の 3 か所
       * （トップレベル・env.production・env.preview）と揃えること。
       * D1・R2・Queue は develop と同じものを指し、データはすべてのプレビューで共有する。
       *
       * Queue の consumer と Cron Triggers はここに書かない。Preview では動かない仕様のため、
       * Preview が積んだメールは、上の Worker 本体（develop）の consumer と Cron が送る。
       */
      "previews": {
        "vars": {
          // 実行環境の名前。詳細はトップレベルの `vars` のコメントを参照。
          "APP_ENV": "preview",
          "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
          // SMTP の設定についてはトップレベルの `vars` のコメントを参照。
          "SMTP_HOST": "smtp.email.ap-osaka-1.oci.oraclecloud.com",
          "SMTP_PORT": "465",
          "MAIL_FROM_ADDRESS": "noreply@gdgoc-osaka.jp",
          "MAIL_FROM_NAME": "i-Club 予約システム",
        },
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "iclub-reserve-preview-db",
            "database_id": "0de33eb1-9e5c-4721-bda8-7dc7c201157a",
            "migrations_dir": "drizzle/migrations",
          },
        ],
        "r2_buckets": [
          {
            "binding": "MEDIA",
            "bucket_name": "iclub-reserve-media-preview",
          },
        ],
        "queues": {
          "producers": [{ "queue": "iclub-reserve-mail-preview", "binding": "MAIL_QUEUE" }],
        },
      },
    },
  },
}
