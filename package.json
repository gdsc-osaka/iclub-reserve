{
  "name": "iclub-reserve",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:production": "cross-env CLOUDFLARE_ENV=production react-router build",
    "build:preview": "cross-env CLOUDFLARE_ENV=preview react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "pnpm run build:production && wrangler deploy --env production",
    "deploy:preview": "pnpm run build:preview && wrangler deploy --env preview",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "db:auth:generate": "auth generate --output ./app/db/schema/auth.ts && oxfmt app/db/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply iclub-reserve-preview-db --local",
    "db:migrate:preview": "wrangler d1 migrations apply iclub-reserve-preview-db --remote --env preview",
    "db:migrate:prod": "wrangler d1 migrations apply iclub-reserve-db --remote --env production",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "node scripts/run-studio.js"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.5.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.21.0",
    "neverthrow": "^8.2.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "auth": "1.7.2",
    "better-sqlite3": "^12.11.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0",
    "zod": "4.4.3"
  }
}
