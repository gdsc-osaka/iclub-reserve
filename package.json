{
  "name": "iclub-reserve",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:production": "cross-env CLOUDFLARE_ENV=production react-router build",
    "build:preview": "cross-env CLOUDFLARE_ENV=preview react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "pnpm run build:production && wrangler deploy --env production",
    "deploy:preview": "pnpm run build:preview && wrangler deploy --env preview",
    "deploy:preview-branch": "pnpm run build:preview && wrangler preview --env preview",
    "preview": "pnpm run build && vp preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types && react-router typegen",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt .",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test run",
    "test:e2e": "pnpm run build && playwright test",
    "db:auth:generate": "auth generate --output ./app/db/schema/auth.ts && vp fmt app/db/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply iclub-reserve-preview-db --local",
    "db:migrate:preview": "wrangler d1 migrations apply iclub-reserve-preview-db --remote --env preview",
    "db:migrate:prod": "wrangler d1 migrations apply iclub-reserve-db --remote --env production",
    "db:seed": "vpx scripts/seed.ts",
    "db:seed:preview": "vpx scripts/seed.ts --remote",
    "db:studio": "vpx scripts/run-studio.ts",
    "dev:otp": "vpx scripts/dev-otp.ts",
    "icons:generate": "vpx scripts/generate-app-icons.ts",
    "prepare": "vp config",
    "release:check-version": "vpx scripts/release/check-version.ts",
    "release:set-version": "vpx scripts/release/set-version.ts",
    "release:migration-plan": "vpx scripts/release/migration-plan.ts",
    "release:unapplied-migrations": "vpx scripts/release/unapplied-migrations.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.18",
    "@fontsource-variable/inter": "^5.3.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.69.0",
    "neverthrow": "^8.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "worker-mailer": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "auth": "1.7.18",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "semver": "^7.8.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.158.0",
    "zod": "4.6.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
