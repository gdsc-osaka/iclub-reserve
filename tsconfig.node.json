{
  "extends": "./tsconfig.json",
  "include": [
    "drizzle.config.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "app/db/schema/**/*",
    "app/domain/**/*",
    "app/components/brand/iclub-bolt.ts",
    "app/lib/date.ts",
    "app/lib/ical.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
